  .r .n small{font-weight:600;font-size:11px;}
  .r .v{width:var(--cw);text-align:right;font-size:var(--fs);font-weight:900;letter-spacing:-.3px;}
  .r .v.s{font-weight:700;}
  .r .c{font-size:11px;font-weight:800;}
  .r .rk{flex:none;width:20px;height:20px;border-radius:50%;background:#000;color:#fff;font-size:12px;font-weight:900;display:inline-flex;align-items:center;justify-content:center;align-self:center;}
  .r .lim{flex:none;font-size:12px;font-weight:700;width:92px;text-align:right;}
  .r .p2{flex:none;font-size:24px;font-weight:900;letter-spacing:-.5px;}
  .msg{font-size:14px;font-weight:700;padding:6px 0;}
  .msg small{display:block;font-weight:500;font-size:11px;}
  .gold{--cw:134px;--fs:17px;}
